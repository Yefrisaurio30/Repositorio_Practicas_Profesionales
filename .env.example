# ==============================================================================
# Copiar este archivo a ".env" en la raiz del proyecto.
# Docker Compose lo lee automaticamente; las variables tambien llegan al
# contenedor por `environment:`. Nunca commitear el .env real.
# ==============================================================================

# --- Django ---
# Solo para desarrollo. En produccion generar una clave real:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=*

# 'local' usa config/settings/local.py (DEBUG=True)
# 'prod'  usa config/settings/prod.py  (DEBUG=False, exige SSL en la BD)
DJANGO_SETTINGS_ENV=local

# --- PostgreSQL (la usa tanto el contenedor 'db' como el backend) ---
# Si cambias DB_PASSWORD aqui, cambialo en los dos lados: Compose lo aplica
# tanto a POSTGRES_PASSWORD como a la variable del backend.
DB_NAME=proyeccion_social
DB_USER=postgres
DB_PASSWORD=1234
DB_PORT=5432

# --- Puertos publicados en el host ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
# REDIS_PORT=6379

# --- Almacenamiento de imagenes ---
# 'local' guarda en backend/media/ (montado como volumen). 'supabase' usa el bucket.
IMAGE_STORAGE=local

# --- Frontend / proxy de Vite ---
# Dentro de Docker el backend se resuelve por el nombre del servicio.
VITE_PROXY_TARGET=http://backend:8080
# true hace que el watcher de Vite use polling (necesario en Windows).
VITE_USE_POLLING=true

# --- CORS / CSRF ---
# Orígenes desde los que el navegador accede a la API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (opcional, solo si IMAGE_STORAGE=supabase) ---
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_BUCKET=publicaciones-images
