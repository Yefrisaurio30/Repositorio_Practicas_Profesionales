# --- Secretos / entorno ---
# Los .env reales NUNCA se committean. Si solo es la plantilla, esa si se sube.
.env
**/.env
!**/.env.example
backend/.env
frontend/.env

# --- Python ---
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
**/*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
db.sqlite3
db.sqlite3-journal

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
# La carpeta dist/ es un artefacto de `npm run build`, se regenera
frontend/dist/

# --- Django collectstatic / uploads ---
backend/staticfiles/
backend/media/

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Docker ---
# El .env de la raiz es el que usa Compose; se ignora aqui a proposito (ya
# cubierto por la regla .env de arriba).

# --- Scripts locales ---
iniciar.ps1
